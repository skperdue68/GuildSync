# =============================================================================
# GuildSync desktop client configuration (optional local overrides)
# =============================================================================
# Packaged defaults normally suffice; every entry here is optional.
#
# Desktop files load in this order, later values winning:
#   1. executable-directory .env
#   2. executable-directory GuildSyncSettings.txt
#   3. working-directory .env
#   4. working-directory GuildSyncSettings.txt
# Real OS environment variables take priority over all of these files.
#
# Do not put server secrets (Discord client secret, JWT secret, database
# password, bot key) in this file. It ships with the desktop app.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. ESO SavedVariables location
# -----------------------------------------------------------------------------

# Optional override for the Elder Scrolls Online SavedVariables directory.
# Leave blank to try the normal default location for your OS/user.
#
# Windows example:
# SAVED_VARS_DIR=C:\Users\YourUserName\Documents\Elder Scrolls Online\live\SavedVariables
# macOS example:
# SAVED_VARS_DIR=/Users/YourUserName/Documents/Elder Scrolls Online/live/SavedVariables
# Linux / Steam Deck / Proton example:
# SAVED_VARS_DIR=~/.local/share/Steam/steamapps/compatdata/306130/pfx/drive_c/users/steamuser/Documents/Elder Scrolls Online/live/SavedVariables
SAVED_VARS_DIR=


# -----------------------------------------------------------------------------
# 2. Watched SavedVariables file names
# -----------------------------------------------------------------------------
# Leave blank to watch the default file name shown in each comment.

# Banking export written by the GuildSyncBanking add-on.
SAVED_VARS_BANKING_FILE_NAME=

# Roster export written by the GuildSyncRoster add-on.
SAVED_VARS_ROSTER_FILE_NAME=

# Applications export written by the GuildSyncApplications add-on.
SAVED_VARS_APPLICATIONS_FILE_NAME=


# -----------------------------------------------------------------------------
# 3. Lua table name overrides
# -----------------------------------------------------------------------------
# Only needed if you renamed the top-level table inside a SavedVariables file.
# Leave blank to use the default table name shown in each comment.

# Defaults to GuildSyncBanking.
SAVED_VARS_BANKING_TABLE_NAME=

# Defaults to GuildSyncRoster.
SAVED_VARS_ROSTER_TABLE_NAME=

# Defaults to GuildSyncApplications.
SAVED_VARS_APPLICATIONS_TABLE_NAME=


# -----------------------------------------------------------------------------
# 4. Backend connection
# -----------------------------------------------------------------------------
# Point these at your backend for public/internet use. Use the same origin for
# both: authentication happens over HTTP and live data over Socket.IO.

# Backend authentication origin.
GUILDSYNC_AUTH_SERVER_URL=https://guildsync.perdues.me

# Backend Socket.IO origin.
GUILDSYNC_SOCKET_URL=https://guildsync.perdues.me


# -----------------------------------------------------------------------------
# 5. Desktop Discord sign-in
# -----------------------------------------------------------------------------

# Loopback listener used by desktop sign-in. Keep the local address; the
# packaged default is shown.
GUILDSYNC_DISCORD_REDIRECT_URI=http://127.0.0.1:53682/callback

# Optional Discord application ID override. Packaged defaults normally suffice;
# leave blank unless you run your own Discord application.
GUILDSYNC_DISCORD_CLIENT_ID=
