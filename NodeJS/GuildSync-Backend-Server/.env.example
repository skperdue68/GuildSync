# =============================================================================
# GuildSync backend server configuration
# =============================================================================
# Copy this file to .env, replace the example secrets, then restart the backend.
# Every value below is an example or a working default, never a real credential.
#
# Contents
#   1. Server bind and public URLs
#   2. Discord OAuth (desktop and web sign-in)
#   3. Sessions and bot authentication
#   4. MariaDB
#   5. ESO guild identity
#   6. Client version, downloads, and served web files
#   7. Raffle bonus defaults
#   8. Deposit receipt mail templates
#   9. Google Sheets export and archive automation
#  10. Live operational overrides (Administrator Configuration)
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Server bind and public URLs
# -----------------------------------------------------------------------------

# HTTP and Socket.IO bind address. Use 0.0.0.0 behind a reverse proxy;
# 127.0.0.1 keeps the server reachable only from this machine.
HOST=0.0.0.0

# HTTP and Socket.IO port.
PORT=3001

# Public origin of the GuildSync web app. Used for absolute links, including
# desktop client downloads. Change this for any deployment other than the
# example one, and keep it in step with the Discord OAuth web callback below.
GUILDSYNC_WEB_PUBLIC_URL=https://guildsync.perdues.me

# Reverse proxy notes (Nginx Proxy Manager):
# - Route this public hostname to HOST:PORT above.
# - Enable WebSocket support so Socket.IO upgrades succeed.
# - The desktop OAuth redirect stays on 127.0.0.1 because the Wails desktop
#   client opens its own loopback listener.

# Obsolete: database storage is managed by MariaDB, not a data directory.
# Kept only so old deployments are not confused by its absence.
# DATA_DIR=


# -----------------------------------------------------------------------------
# 2. Discord OAuth (desktop and web sign-in)
# -----------------------------------------------------------------------------

# Discord application ID. The same application serves desktop and web sign-in.
DISCORD_CLIENT_ID=123456789012345678

# Discord application client secret. Server-side only: never ship it in the
# desktop client or in any browser code.
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET

# Loopback callback used by the desktop client. This exact URL must be listed
# as a redirect in the Discord application.
DISCORD_REDIRECT_URI=http://127.0.0.1:53682/callback

# Browser callback for web sign-in. Must match Discord's redirect list and
# point at this backend's public origin.
DISCORD_WEB_REDIRECT_URI=https://guildsync.perdues.me/api/auth/discord/web-callback


# -----------------------------------------------------------------------------
# 3. Sessions and bot authentication
# -----------------------------------------------------------------------------

# Long random secret used to sign GuildSync session tokens. Generate a unique
# value for production, keep it private, and changing it signs everyone out.
GUILDSYNC_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Shared key the Discord bot uses to authenticate over Socket.IO. Must match
# the bot's GUILDSYNC_BOT_KEY exactly.
GUILDSYNC_BOT_SOCKET_KEY=MATCH_THE_BOT_GUILDSYNC_BOT_KEY

# Legacy example setting. Sessions are signed JWTs and do not use this value,
# so leaving it unset or setting it does not change session lifetime.
# GUILDSYNC_TOKEN_TTL_SECONDS=86400


# -----------------------------------------------------------------------------
# 4. MariaDB
# -----------------------------------------------------------------------------

# Database connection. The account needs rights to create/update the database
# schema on first startup. Use a separate MARIADB_DATABASE per ESO guild.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=guildsync
MARIADB_PASSWORD=YOUR_DATABASE_PASSWORD
MARIADB_DATABASE=guildsync

# Connection pool size; raise it only if the database can handle it.
MARIADB_CONNECTION_LIMIT=10


# -----------------------------------------------------------------------------
# 5. ESO guild identity
# -----------------------------------------------------------------------------

# Stable numeric ESO guild ID accepted for GuildSyncApplications.lua records.
# This is the in-game guild ID, not a Discord server ID.
GUILDSYNC_APPLICATIONS_GUILD_ID=761817

# Optional migration setting: stable numeric ESO guild ID. Once set it
# enforces one guild across roster, banking, and applications and binds this
# database to that guild. Set it only after updating the ESO add-ons and
# replaying or refreshing untagged pending exports.
# Leave blank for legacy mode. If both settings are supplied, the applications
# guild ID must match this value. Use a separate backend, bot, and database per
# guild.
GUILDSYNC_ESO_GUILD_ID=


# -----------------------------------------------------------------------------
# 6. Client version, downloads, and served web files
# -----------------------------------------------------------------------------

# Release version. tools/update-version.go stamps this during a release, but the
# backend reads package.json at runtime and ignores this value (it logs a warning
# when the two differ). Keep it in step so the release check stays green.
GUILDSYNC_CLIENT_VERSION=1.5.0

# Optional minimum desktop version. Blank or unset keeps enforcement disabled;
# otherwise use a release version such as 1.5.0.
GUILDSYNC_MIN_DESKTOP_VERSION=

# Fallback download page when no compatible local installer is available.
GUILDSYNC_DESKTOP_UPDATE_URL=https://github.com/skperdue68/GuildSync/releases/latest

# Optional served web bundle directory. Blank uses the backend public default.
GUILDSYNC_WEB_DIST_DIR=

# Optional installer download directory. Blank uses public/downloads.
GUILDSYNC_DOWNLOADS_DIR=


# -----------------------------------------------------------------------------
# 7. Raffle bonus defaults
# -----------------------------------------------------------------------------
# These are initial defaults only. Saved database policies and per-raffle
# overrides take precedence. Tiers are "hours:bonus_percent" pairs.

GUILDSYNC_RAFFLE_BONUS_ENABLED=true
GUILDSYNC_BIWEEKLY_BONUS_TIERS=120:20,120:10,72:5,24:0
GUILDSYNC_MONTHLY_BONUS_TIERS=168:40,168:20,168:10,144:5,24:0


# -----------------------------------------------------------------------------
# 8. Deposit receipt mail templates
# -----------------------------------------------------------------------------
# Rendered by the backend when banking mail is checked out.
#
# Supported placeholders: {recipient}, {account_name}, {display_name},
# {event_id}, {ticket_type}, {ticket_type_raw}, {transaction_type}, {amount},
# {deposit_amount}, {gold_cost}, {raw_amount}, {raw_deposit_amount},
# {ticket_gold_cost}, {raw_ticket_gold_cost}, {raw_gold_cost}, {ticket_quantity},
# {tickets}, {purchased_tickets}, {purchase_date}, {data_source},
# {raffle_datetime_eastern}, {raffle_datetime}, {event_datetime},
# {event_timestamp}, {mail_request_id}, {mail_batch_id}, {note}, {note_block},
# {bonus_block}, {bonus_percent}, {bonus_tickets}, {total_tickets},
# {bonus_deadline}
#
# {amount}, {deposit_amount}, {ticket_gold_cost}, and {gold_cost} are the actual
# ESO deposit/ticket cost including any +1/+3 raffle marker; raffle summaries
# strip the marker only for display. Unknown placeholders remain literal.
# Node dotenv double-quoted values support escaped \n line breaks.

# Testing override: send every checked-out receipt to one account.
# Leave blank for normal recipients.
GUILDSYNC_DEPOSIT_MAIL_FORCE_RECIPIENT=

GUILDSYNC_DEPOSIT_MAIL_SUBJECT_TEMPLATE=Alphabet Mafia Raffle Ticket Receipt
GUILDSYNC_DEPOSIT_MAIL_BODY_TEMPLATE="Hi {recipient},\n\nThank you for supporting Alphabet Mafia!\n\nTicket Type: {ticket_type}\nNumber of Tickets Purchased: {ticket_quantity}\nPurchase Date: {purchase_date}\nTotal Cost: {ticket_gold_cost} gold\n{note_block}\nRaffle Date: {raffle_datetime_eastern}.\n\nYou don't have to be present at the guild hall for the drawing to win! But you'll get bonus tickets and a chance at an extra prize if you're there, so we hope you can join us! \n\nThanks again\nThe Alphabet Mafia Consiglieri"


# -----------------------------------------------------------------------------
# 9. Google Sheets export and archive automation
# -----------------------------------------------------------------------------
# Optional. Ordinary spreadsheet writes stay disabled unless explicitly
# enabled; banking database ingestion works either way.

GUILDSYNC_GOOGLE_SHEETS_ENABLED=false

# Stable working workbook ID (not a tab gid and not an archive ID).
GUILDSYNC_GOOGLE_SHEETS_SPREADSHEET_ID=

# Backend-readable service-account JSON key file...
GUILDSYNC_GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# ...or the complete service-account JSON as one secret value. Inline JSON
# takes precedence over the file, so clear it when switching back to a file.
GUILDSYNC_GOOGLE_SERVICE_ACCOUNT_JSON=

# Exact tab titles, including spelling and case, in the working workbook.
GUILDSYNC_GOOGLE_SHEETS_BIWEEKLY_TAB=bi-weekly raffle
GUILDSYNC_GOOGLE_SHEETS_5050_TAB=50/50

# Sheets operation/diagnostic log. Relative paths resolve from this directory.
GUILDSYNC_GOOGLE_SHEETS_LOG_FILE=logs/google-sheets.log

# Hold sheet writes after the sales cutoff, then archive/reset and replay
# database entries. Deploy scripts/google-apps-script/Archive.gs first; see
# docs/google-sheets-logging.md.
GUILDSYNC_GOOGLE_SHEETS_ROLLOVER_ENABLED=false
GUILDSYNC_GOOGLE_SHEETS_ROLLOVER_DELAY_HOURS=4

# Existing Apps Script deployment URL ending in /exec (not /dev) and the
# secret that matches its ARCHIVE_SECRET script property.
GUILDSYNC_GOOGLE_ARCHIVE_WEB_APP_URL=
GUILDSYNC_GOOGLE_ARCHIVE_SECRET=


# -----------------------------------------------------------------------------
# 10. Live operational overrides (Administrator Configuration)
# -----------------------------------------------------------------------------
# Some settings above may be overridden without editing this file, in
# GuildSync Reports & Admin -> Administrator Configuration:
#   GUILDSYNC_GOOGLE_SHEETS_ENABLED
#   GUILDSYNC_GOOGLE_SHEETS_ROLLOVER_ENABLED
#   GUILDSYNC_GOOGLE_SHEETS_ROLLOVER_DELAY_HOURS
#   GUILDSYNC_DEPOSIT_MAIL_SUBJECT_TEMPLATE
#   GUILDSYNC_DEPOSIT_MAIL_BODY_TEMPLATE
# Removing a saved override restores the value in this file. Editing this file
# requires a restart; saved overrides apply live and survive restarts.
#
# Bot-owned settings (member onboarding, voice mute, raffle announcements,
# archive notifications) are NOT read from this file. Set those in
# NodeJS/GuildSync-Discord-Bot/.env instead.
# See docs/GuildSync-Admin-Configuration.md and docs/GuildSync-Detailed-Help.md.
