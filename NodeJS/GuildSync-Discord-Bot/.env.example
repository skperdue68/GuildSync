DISCORD_TOKEN=YOUR_DISCORD_TOKEN
DISCORD_CLIENT_ID=YOUR_CLIENT ID
DISCORD_GUILD_ID=YOUR_GUILD_ID

GUILDSYNC_SOCKET_URL=http://localhost:3001
GUILDSYNC_BOT_KEY=KEY MUST BE SAME IN GUILDLSYNC ALSO

# Optional. If true, the bot checks the GuildSync backend on startup and runs a one-time
# historical message scan if never completed or the last completion is at least 7 days old.
GUILDSYNC_HISTORICAL_SCAN_ON_STARTUP=true

# Optional. Maximum historical messages to check per text/announcement channel.
GUILDSYNC_HISTORICAL_SCAN_MESSAGE_LIMIT_PER_CHANNEL=1000

#Server/Thread where the Applications are posted to from GuildSyncAppliations
ESO_GUILD_APPLICATIONS=Server_ID:Thread_ID

# Optional raffle announcements. Leave channel blank to disable (does not disable /raffle).
# Bot needs View Channel, Send Messages, and Read Message History in DISCORD_GUILD_ID.
GUILDSYNC_RAFFLE_CHANNEL_ID=
GUILDSYNC_RAFFLE_INTERVAL_HOURS=48
# When true, purchase changes replace interval and prize-milestone value posts.
# Bonus/sales-closing deadline reminders remain independently configured.
GUILDSYNC_RAFFLE_ANNOUNCE_ON_PURCHASE=false
# Positive hours before each bonus change/expiration or sales close; comma-separated
# values (for example 24,2,1) enable multiple reminders. Leave these defaults if unsure.
GUILDSYNC_RAFFLE_BONUS_REMINDER_HOURS=1
GUILDSYNC_RAFFLE_SALES_CLOSE_REMINDER_HOURS=2
# Thresholds are increments in PRIZE GOLD, not deposited gold.
GUILDSYNC_RAFFLE_BIWEEKLY_THRESHOLD=200000
GUILDSYNC_RAFFLE_MONTHLY_THRESHOLD=500000
# Relative to the bot directory. Keep this file across deployments/restarts.
GUILDSYNC_RAFFLE_STATE_FILE=data/raffle-announcements.json

# Archive completion announcements (automatic and /gsr archive).
# Comma-separated channel IDs; blank disables. Requires Read Message History.
GUILDSYNC_RAFFLE_ARCHIVE_CHANNEL_IDS=
# Preserve this file across restarts; use one bot instance per state file.
GUILDSYNC_RAFFLE_ARCHIVE_STATE_FILE=data/raffle-archive-announcements.json

# Member onboarding. See MEMBER-ONBOARDING.md for setup, permissions, and templates.
# Disabled by default. Restart the bot after changing these settings.
GUILDSYNC_ONBOARDING_ENABLED=false
GUILDSYNC_ONBOARDING_PROMOTION_ENABLED=true
GUILDSYNC_ONBOARDING_PROMOTION_NOTIFY_ENABLED=true
GUILDSYNC_ONBOARDING_REMINDER_ENABLED=true
GUILDSYNC_ONBOARDING_REMINDER_HOURS=24
# private_thread prefers a private member thread; if creation is not permitted,
# it creates/reuses a public thread under the same CHANNEL_ID. Grant Create Public Threads.
# channel posts visibly to the configured channel or thread instead. No DMs.
GUILDSYNC_ONBOARDING_NOTIFICATION_MODE=private_thread
GUILDSYNC_ONBOARDING_CHANNEL_ID=
# Optional role names or numeric IDs; names are case insensitive and must omit @.
# Example: Gangsters / Associates. Blank resolves those unique role names.
GUILDSYNC_ONBOARDING_GANGSTER_ROLE_ID=
GUILDSYNC_ONBOARDING_ASSOCIATE_ROLE_ID=
# Blank uses defaults. Supported placeholders: {mention}, {eso_name}, {associate_role}, {hours}.
GUILDSYNC_ONBOARDING_PROMOTION_MESSAGE=
GUILDSYNC_ONBOARDING_REMINDER_MESSAGE=

# Operational settings can be overridden live in GuildSync Reports & Admin.
# Removing a saved override restores these defaults. Editing this file requires restart.
# See docs/GuildSync-Admin-Configuration.md for the allowlist and restrictions.
GUILDSYNC_RAFFLE_ANNOUNCEMENTS_ENABLED=true
GUILDSYNC_RAFFLE_ARCHIVE_ANNOUNCEMENTS_ENABLED=true
# Hold-to-mute is opt-in; empty allowed roles authorize nobody.
GUILDSYNC_VOICE_MUTE_ENABLED=false
# Role names (case insensitive, no @) or numeric IDs, e.g. Kingpin, Consigliere.
GUILDSYNC_VOICE_MUTE_ALLOWED_ROLE_IDS=
# Ordered lowest to highest. Empty discovers recognized guild-rank role names.
GUILDSYNC_VOICE_MUTE_RANK_ROLE_IDS=
