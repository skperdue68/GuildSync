# =============================================================================
# GuildSync Discord bot configuration
# =============================================================================
# Copy this file to .env, replace the example secrets, then restart the bot.
# Every value below is an example or a working default, never a real credential.
#
# Contents
#   1. Discord connection
#   2. GuildSync backend connection
#   3. Historical activity scan
#   4. Guild applications
#   5. Raffle announcements
#   6. Archive completion announcements
#   7. Voice channel hotkey mute
#   8. Member onboarding
#   9. Live operational overrides (Administrator Configuration)
#
# The bot also needs the privileged Server Members Intent enabled in the
# Discord developer portal for membership sync and onboarding.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Discord connection
# -----------------------------------------------------------------------------

# Bot token. Used to log in and, with DISCORD_CLIENT_ID, to register commands.
DISCORD_TOKEN=YOUR_DISCORD_TOKEN

# Discord application ID, used by "npm run deploy" to register commands.
DISCORD_CLIENT_ID=123456789012345678

# Discord server this bot works in: membership sync, commands, announcements,
# and onboarding. This is a Discord server ID, not an ESO guild ID.
DISCORD_GUILD_ID=123456789012345678


# -----------------------------------------------------------------------------
# 2. GuildSync backend connection
# -----------------------------------------------------------------------------

# Backend HTTP(S)/Socket.IO origin.
GUILDSYNC_SOCKET_URL=http://localhost:3001

# Shared key that authenticates this bot to the backend. Must match the
# backend's GUILDSYNC_BOT_SOCKET_KEY exactly.
GUILDSYNC_BOT_KEY=MATCH_THE_BACKEND_GUILDSYNC_BOT_SOCKET_KEY


# -----------------------------------------------------------------------------
# 3. Historical activity scan
# -----------------------------------------------------------------------------

# Optional. When true, the bot checks the backend on startup and runs a
# one-time historical message scan if it never completed or the last completion
# is at least seven days old. This is not a periodic timer.
GUILDSYNC_HISTORICAL_SCAN_ON_STARTUP=true

# Optional. Maximum historical messages checked per text/announcement channel.
GUILDSYNC_HISTORICAL_SCAN_MESSAGE_LIMIT_PER_CHANNEL=1000


# -----------------------------------------------------------------------------
# 4. Guild applications
# -----------------------------------------------------------------------------

# Destination for application posts from GuildSyncApplications.lua, written as
# DiscordServerID:ExistingThreadID. The destination must be a thread.
ESO_GUILD_APPLICATIONS=123456789012345678:123456789012345678

# Optional. Defaults to enabled. Set false to keep ordinary application posts
# without automatic returning-member rank restoration.
GUILDSYNC_APPLICATION_RESTORE_RANK_ENABLED=true

# Optional. Officer role name or numeric role ID, without @, used when
# restoring a returning member's rank. Defaults to Consigliere; aliases such as
# Consiglieri are recognized.
GUILDSYNC_APPLICATION_OFFICER_ROLE=Consigliere


# -----------------------------------------------------------------------------
# 5. Raffle announcements
# -----------------------------------------------------------------------------
# Optional. Leave the channel blank to disable announcements; /raffle still
# works. Needs View Channel, Send Messages, and Read Message History in
# DISCORD_GUILD_ID.

# Master switch for raffle announcements and scheduled raffle reminders.
# Archive notifications are controlled separately in section 6.
GUILDSYNC_RAFFLE_ANNOUNCEMENTS_ENABLED=true

# Channel receiving raffle announcements and deadline reminders.
GUILDSYNC_RAFFLE_CHANNEL_ID=

# Hours between recurring announcements while sales are open.
GUILDSYNC_RAFFLE_INTERVAL_HOURS=48

# When true, purchase changes replace interval and prize-milestone posts.
# Bonus and sales-closing deadline reminders remain independently configured.
GUILDSYNC_RAFFLE_ANNOUNCE_ON_PURCHASE=false

# Positive hours before each bonus change/expiration or sales close;
# comma-separated values (for example 24,2,1) enable several reminders.
GUILDSYNC_RAFFLE_BONUS_REMINDER_HOURS=1
GUILDSYNC_RAFFLE_SALES_CLOSE_REMINDER_HOURS=2

# Milestone increments in PRIZE GOLD, not deposited gold.
GUILDSYNC_RAFFLE_BIWEEKLY_THRESHOLD=200000
GUILDSYNC_RAFFLE_MONTHLY_THRESHOLD=500000

# Delivery/milestone state relative to this directory. Keep this file across
# deployments and run one announcing bot instance per state file.
GUILDSYNC_RAFFLE_STATE_FILE=data/raffle-announcements.json


# -----------------------------------------------------------------------------
# 6. Archive completion announcements
# -----------------------------------------------------------------------------
# Posted after an archive completes, both automatically and via /gsr archive.
# This does not enable or disable archiving itself.

GUILDSYNC_RAFFLE_ARCHIVE_ANNOUNCEMENTS_ENABLED=true

# Comma-separated channel IDs receiving archive and working-sheet links.
# Blank disables. Requires Read Message History. There is no fallback to the
# ordinary raffle channel.
GUILDSYNC_RAFFLE_ARCHIVE_CHANNEL_IDS=

# Per-archive/per-channel delivery state. Preserve across restarts.
GUILDSYNC_RAFFLE_ARCHIVE_STATE_FILE=data/raffle-archive-announcements.json


# -----------------------------------------------------------------------------
# 7. Voice channel hotkey mute
# -----------------------------------------------------------------------------
# Hold-to-mute is opt-in. Requires Manage Roles with the bot's highest role
# above the roles it may mute.

GUILDSYNC_VOICE_MUTE_ENABLED=false

# Comma-separated role names (case insensitive, no @) or numeric IDs allowed to
# request a mute, for example Kingpin, Consigliere. Blank authorizes nobody.
GUILDSYNC_VOICE_MUTE_ALLOWED_ROLE_IDS=

# Guild rank roles, lowest to highest, as names or numeric IDs. Blank discovers
# recognized guild-rank role names. Equal, higher, and unknown ranks are never
# muted.
GUILDSYNC_VOICE_MUTE_RANK_ROLE_IDS=


# -----------------------------------------------------------------------------
# 8. Member onboarding
# -----------------------------------------------------------------------------
# Master switch for promotions and reminders; disabled by default. Restart the
# bot after editing. Enabling with reminders or promotion notifications on
# requires GUILDSYNC_ONBOARDING_CHANNEL_ID. See MEMBER-ONBOARDING.md for
# permissions and templates.

GUILDSYNC_ONBOARDING_ENABLED=false

# Promote confirmed-linked Gangsters to Associates when the master switch is on.
GUILDSYNC_ONBOARDING_PROMOTION_ENABLED=true

# Post a message after a successful promotion. False permits silent role changes.
GUILDSYNC_ONBOARDING_PROMOTION_NOTIFY_ENABLED=true

# Enroll new members and send one reminder when they still have no ESO link.
GUILDSYNC_ONBOARDING_REMINDER_ENABLED=true

# Hours after joining before that one-time reminder (positive, up to 8760).
GUILDSYNC_ONBOARDING_REMINDER_HOURS=24

# private_thread creates a private member thread, falling back to a public
# thread under the same channel; channel posts visibly to the configured
# channel or thread instead. No DMs are sent.
GUILDSYNC_ONBOARDING_NOTIFICATION_MODE=private_thread

# Normal text channel in private_thread mode, or an existing channel/thread in
# channel mode. Not needed for a silent promotion-only setup.
GUILDSYNC_ONBOARDING_CHANNEL_ID=

# Optional role names or numeric IDs. Names are case insensitive and omit @.
# Blank resolves the unique role names Gangsters and Associates.
GUILDSYNC_ONBOARDING_GANGSTER_ROLE_ID=
GUILDSYNC_ONBOARDING_ASSOCIATE_ROLE_ID=

# Blank uses the built-in text. Supported placeholders:
# {mention}, {eso_name}, {associate_role}, {hours}
GUILDSYNC_ONBOARDING_PROMOTION_MESSAGE=
GUILDSYNC_ONBOARDING_REMINDER_MESSAGE=


# -----------------------------------------------------------------------------
# 9. Live operational overrides (Administrator Configuration)
# -----------------------------------------------------------------------------
# The settings in sections 5-8 can also be changed live in GuildSync
# Reports & Admin -> Administrator Configuration, without editing this file.
# The raffle state file paths, guild application settings, and historical scan
# settings are read only from this file.
# A saved override is stored in the backend database, applies to the connected
# bot, and survives restarts of both processes. Choosing the option marked
# (Default), or using Return to default, restores the value in this file.
# The values here are what the bot reports as defaults when it connects, so
# editing this file still requires a bot restart.
# See docs/GuildSync-Admin-Configuration.md for restrictions.
